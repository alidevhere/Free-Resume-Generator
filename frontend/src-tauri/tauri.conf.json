{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free Resume Generator",
  "version": "0.1.0",
  "identifier": "com.free.resume.generator",
  "build": {
    "beforeDevCommand": "npm run tauri:frontend:dev",
    "beforeBuildCommand": "npm run tauri:frontend:build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Free Resume Generator",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/backend"
    ]
  }
}
